# =============================================================
# Root .env.example — documentation only.
# Tools (Docker Compose, Makefile, CI bootstrap) read this for
# the union of variables, but actual secrets live in the
# per-app .env files (gitignored).
#
# Per spec mục 16, biến được nhóm theo milestone triển khai.
# =============================================================

# === Milestone 0 — Khởi tạo ===
# Flutter app base config
APP_ENV=development
LOCALE=vi-VN
TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VND

# Supabase (client + local stack)
SUPABASE_URL=
SUPABASE_ANON_KEY=
AUTH_JWT_SECRET=
AUTH_DISABLE_SIGNUP=true

# === Milestone 1 — Domain & dữ liệu lõi ===
# Supabase (server — KHÔNG đưa vào Flutter bundle)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Local storage crypto (32 bytes base64)
ENCRYPTION_KEY=
APP_STATE_KEY=
SIGNED_URL_TTL_SECONDS=300

# === Milestone 4 — Bank sandbox ===
# Casso provider (sandbox API Key)
BANK_PROVIDER=casso
BANK_SYNC_ENABLED=false
BANK_WEBHOOK_URL=
BANK_RECONCILE_CRON=0 */6 * * *
BANK_RECONCILE_WINDOW_DAYS=14

CASSO_BASE_URL=https://oauth.casso.vn/v2
CASSO_API_KEY=
CASSO_PLAN=mock
CASSO_RATE_LIMIT_PER_MIN=20
CASSO_LINK_URL=https://my.casso.vn

# === Milestone 5 — Provider thật ===
# Chỉ thêm sau khi đã xác nhận provider theo mục 23 spec
# BANK_CLIENT_ID=
# BANK_CLIENT_SECRET=
# BANK_WEBHOOK_SECRET=
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_API_KEY=

# === Milestone 6 — Hardening & release ===
# Monitoring & backup
# SENTRY_DSN=
# SENTRY_ENV=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# STORAGE_BUCKET_BACKUPS=finance-backups
# STORAGE_BUCKET_EXPORTS=finance-exports

# =============================================================
# Biến đã xác định KHÔNG cần — không thêm:
#   CASSO_SECURE_TOKEN       Casso v2 dùng API Key, không OAuth
#   BANK_TINK_CLIENT_ID      Provider chọn là Casso, không Tink
# =============================================================