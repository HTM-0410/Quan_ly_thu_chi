# =============================================================
# Supabase local stack + Edge Functions (server-side)
# Copy to supabase/.env (gitignored). For production use
# `supabase secrets set --env-file supabase/.env.production`.
# =============================================================

ENV=development
PROJECT_NAME=quan-ly-thu-chi

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOi...local-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...local-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Auth
AUTH_JWT_SECRET=replace-with-strong-random-secret
AUTH_DISABLE_SIGNUP=true
AUTH_SITE_URL=http://localhost:3000
AUTH_MAILER_AUTOCONFIRM=true

# Bank connector
BANK_PROVIDER=casso
BANK_SYNC_ENABLED=false
BANK_WEBHOOK_URL=http://localhost:54321/functions/v1/bank-webhook/casso
BANK_RECONCILE_CRON=0 */6 * * *
BANK_RECONCILE_WINDOW_DAYS=14

# Casso (use sandbox keys for local)
CASSO_BASE_URL=https://oauth.casso.vn/v2
CASSO_API_KEY=replace-with-casso-api-key
CASSO_SECURE_TOKEN=replace-with-casso-secure-token
CASSO_PLAN=mock
CASSO_RATE_LIMIT_PER_MIN=20
CASSO_WEBHOOK_TIMEOUT_MS=5000
CASSO_REQUEST_TIMEOUT_MS=10000
CASSO_LINK_URL=https://my.casso.vn

# Encryption (32 bytes base64; rotate via KMS in production)
ENCRYPTION_KEY=base64-encoded-32-bytes==
APP_STATE_KEY=base64-encoded-32-bytes==

# Monitoring
SENTRY_DSN=https://publicKey@sentry.io/projectId
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info
LOG_WEBHOOK_BODY=false

# Push
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json
FCM_DEFAULT_CHANNEL=finance_general

# Storage
STORAGE_BUCKET_BACKUPS=finance-backups
STORAGE_BUCKET_EXPORTS=finance-exports
SIGNED_URL_TTL_SECONDS=300

# Cron
PG_CRON_SCHEMA=extensions
