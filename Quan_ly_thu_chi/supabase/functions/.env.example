# =============================================================
# Edge Functions (Deno)
# Variables read via Deno.env.get().
# In production: `supabase secrets set NAME=value`
# Local: copy to supabase/functions/.env (gitignored).
# =============================================================

ENV=development
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOi...local-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...local-service-role-key

# Casso
CASSO_BASE_URL=https://oauth.casso.vn/v2
CASSO_API_KEY=
CASSO_SECURE_TOKEN=
CASSO_PLAN=mock
CASSO_RATE_LIMIT_PER_MIN=20
CASSO_WEBHOOK_TIMEOUT_MS=5000
CASSO_REQUEST_TIMEOUT_MS=10000

# Encryption / keys
ENCRYPTION_KEY=
APP_STATE_KEY=

# FCM
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info
LOG_WEBHOOK_BODY=false
