# =============================================================
# Web (Vite) environment variables — required prefix VITE_
# Copy sang .env.local khi dev, .env.production khi build prod.
# Tất cả giá trị nhúng vào bundle đều là public-by-design
# (anon key chỉ có quyền đọc theo RLS).
# =============================================================

# TODO: thay bằng URL + anon key của project Supabase của bạn.
# Lấy trong Supabase Dashboard → Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — defaults đã có sẵn trong code
VITE_APP_ENV=production
VITE_LOCALE=vi-VN
VITE_CURRENCY=VND

# =============================================================
# OCR (LLM Vision) — dùng Google Gemini để đọc ảnh giao dịch.
# QUAN TRỌNG:
#   - Lấy key tại https://aistudio.google.com/app/apikey (miễn phí).
#   - KHÔNG commit key thật. Paste vào .env.local rồi restart dev server.
#   - Key sẽ được bundle vào file JS khi build. Nếu deploy public,
#     bật HTTP referrer restriction trong Google Cloud Console.
#   - Để trống = tắt tính năng OCR (modal sẽ hiện hướng dẫn).
# =============================================================
VITE_GEMINI_API_KEY=
VITE_OCR_MODEL=gemini-3.5-flash-lite